# ============================================
# CINEMA MULTI-SALA - ENVIRONMENT VARIABLES
# ============================================
# Copia questo file come env.properties e inserisci le tue credenziali

# Database
DB_URL=jdbc:postgresql://localhost:5432/Cinema
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_256_bits
JWT_EXPIRATION=86400000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mailgun
MAILGUN_ENABLED=true
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Cinema Multi-Sala

# Server
SERVER_PORT=8080
